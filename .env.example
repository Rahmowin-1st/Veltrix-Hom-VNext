VELTRIX_ENV=development
VELTRIX_DATABASE_URL=jdbc:postgresql://veltrix:veltrix@localhost:5432/veltrix_vnext
VELTRIX_AI_PROVIDER=disabled
VELTRIX_AI_API_KEY=
VELTRIX_AI_BASE_URL=
VELTRIX_OBJECT_STORAGE_ENDPOINT=
VELTRIX_OBJECT_STORAGE_BUCKET=veltrix-vnext-dev
# Optional server-side translation gateway (LibreTranslate-compatible JSON contract).
# Never put privileged provider keys in the Android APK.
VELTRIX_TRANSLATION_URL=
VELTRIX_TRANSLATION_API_KEY=
# Deterministic CI only; never enabled in production.
VELTRIX_TEST_TRANSLATE_MOCK=false
# Server-side source processing/storage. Production should point this abstraction at protected object storage or a mounted private volume.
VELTRIX_SOURCE_STORAGE_ROOT=./var/source-storage
# Optional server-side OCR gateway. Credentials remain server-side.
VELTRIX_OCR_GATEWAY_URL=
VELTRIX_OCR_GATEWAY_API_KEY=
# Server-side source processing/storage. Production should point this abstraction at protected object storage or a mounted private volume.
VELTRIX_SOURCE_STORAGE_ROOT=./var/source-storage
# Optional server-side OCR gateway. Credentials remain server-side.
VELTRIX_OCR_GATEWAY_URL=
VELTRIX_OCR_GATEWAY_API_KEY=
